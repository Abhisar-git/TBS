# TBS — Environment Variables
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/tbs?schema=public"

# JWT Secret (change in production!)
JWT_SECRET="tbs-dev-secret-key-change-in-production-2024"

# OpenRouteService (optional — free tier, no key needed for basic usage)
# Get a key at https://openrouteservice.org/dev/#/signup for higher rate limits
ORS_API_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
