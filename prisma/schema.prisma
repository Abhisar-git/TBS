// ============================================================
// TBS — Prisma Schema (PostgreSQL for Neon DB & Vercel)
// Complete data model for the event transport dispatch system
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- User & Auth ----------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  passwordHash String   @map("password_hash")
  role         String   @default("GUEST") // GUEST, DRIVER, ADMIN
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  guestProfile GuestProfile?
  driverProfile DriverProfile?
  approvedRequests RideRequest[] @relation("ApprovedByAdmin")

  @@map("users")
}

// ---------- Accommodations ----------

model Accommodation {
  id        String   @id @default(uuid())
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  guests GuestProfile[]

  @@map("accommodations")
}

// ---------- Guest Profile & Travel Details ----------

model GuestProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  flightOrTrainNumber String?  @map("flight_or_train_number")
  groupSize           Int      @default(1) @map("group_size")
  luggageCount        Int      @default(1) @map("luggage_count")
  status              String   @default("REGISTERED") // REGISTERED, WAITING, ASSIGNED, IN_TRANSIT, ARRIVED
  pickupPoint         String?  @map("pickup_point")
  accommodationId     String?  @map("accommodation_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id])
  rideRequests  RideRequest[]
  tripPassengers TripPassenger[]

  @@map("guest_profiles")
}

// ---------- Driver Profile & Fleet Specifications ----------

model DriverProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  vehicleNumber    String   @map("vehicle_number")
  vehicleModel     String   @default("Standard Sedan") @map("vehicle_model")
  seatCapacity     Int      @default(4) @map("seat_capacity")
  luggageCapacity  Int      @default(3) @map("luggage_capacity")
  status           String   @default("AVAILABLE") // AVAILABLE, EN_ROUTE, ON_TRIP, ON_BREAK, OFFLINE
  currentLat       Float?   @map("current_lat")
  currentLng       Float?   @map("current_lng")
  locationUpdatedAt DateTime? @map("location_updated_at")
  breakUntil       DateTime? @map("break_until")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@map("driver_profiles")
}

// ---------- Ride Requests ----------

model RideRequest {
  id             String   @id @default(uuid())
  guestProfileId String   @map("guest_profile_id")
  pickupPoint    String   @map("pickup_point")
  dropoffPoint   String   @map("dropoff_point")
  status         String   @default("PENDING") // PENDING, APPROVED, DECLINED, MATCHED
  approvedById   String?  @map("approved_by_id")
  declineReason  String?  @map("decline_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  guestProfile GuestProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  approvedBy   User?         @relation("ApprovedByAdmin", fields: [approvedById], references: [id])

  @@map("ride_requests")
}

// ---------- Trips & Assignments ----------

model Trip {
  id                 String    @id @default(uuid())
  tripType           String    @default("ARRIVAL") // ARRIVAL, DEPARTURE, VENUE_TRANSFER, ON_DEMAND
  driverId           String?   @map("driver_id")
  status             String    @default("PENDING") // PENDING, DRIVER_ASSIGNED, DRIVER_EN_ROUTE, DRIVER_ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED
  pickupAddress      String    @map("pickup_address")
  pickupLat          Float     @map("pickup_lat")
  pickupLng          Float     @map("pickup_lng")
  dropoffAddress     String    @map("dropoff_address")
  dropoffLat         Float     @map("dropoff_lat")
  dropoffLng         Float     @map("dropoff_lng")
  scheduledPickupAt  DateTime? @map("scheduled_pickup_at")
  actualStartAt      DateTime? @map("actual_start_at")
  actualEndAt        DateTime? @map("actual_end_at")
  actualDurationSec  Int?      @map("actual_duration_sec")
  actualDistanceM    Int?      @map("actual_distance_m")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  driver     DriverProfile?  @relation(fields: [driverId], references: [id])
  passengers TripPassenger[]

  @@map("trips")
}

// ---------- Trip Passengers (Many-to-Many Join with Status) ----------

model TripPassenger {
  id             String   @id @default(uuid())
  tripId         String   @map("trip_id")
  guestProfileId String   @map("guest_profile_id")
  boardingStatus String   @default("ASSIGNED") // ASSIGNED, BOARDED, DROPPED_OFF
  createdAt      DateTime @default(now()) @map("created_at")

  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guestProfile GuestProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)

  @@map("trip_passengers")
}

// ---------- Distance Cache (2-Tier In-Memory + DB Cache) ----------

model DistanceCache {
  id          String   @id @default(uuid())
  originHash  String   @map("origin_hash")
  destHash    String   @map("dest_hash")
  durationSec Int      @map("duration_sec")
  distanceM   Int      @map("distance_m")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([originHash, destHash])
  @@map("distance_cache")
}
